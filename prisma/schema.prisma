datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  username     String        @unique
  passwordHash String
  fullName     String
  role         Role          @default(USER)
  avatarUrl    String?
  isActive     Boolean       @default(true)
  disabledAt   DateTime?
  disabledReason String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  cvs          CV[]
  logs         ActivityLog[]

  @@map("users")
}

model CV {
  id           String    @id @default(uuid())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug         String    @unique
  title        String
  isPublished  Boolean   @default(false)
  publishedAt  DateTime?
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  templateId   String    @default("modern-clean")
  data         Json
  createdBy    String?
  createdByName String?
  updatedBy    String?
  updatedByName String?
  version      Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("cvs")
}

model ActivityLog {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type          String
  title         String
  details       String
  cvId          String?
  candidateName String?
  createdAt     DateTime @default(now())

  @@map("activity_logs")
}

model ExportMetric {
  id            String   @id @default(uuid())
  type          String
  cvId          String?
  candidateName String?
  createdAt     DateTime @default(now())

  @@map("export_metrics")
}

// Nightly stats snapshot. Writing a row every night doubles as the keep-alive
// activity that prevents Supabase's free tier from pausing the project.
model HealthReport {
  id        String   @id @default(uuid())
  users     Int      @default(0)
  cvs       Int      @default(0)
  published Int      @default(0)
  views     Int      @default(0)
  exports   Int      @default(0)
  logs      Int      @default(0)
  source    String   @default("scheduled")
  payload   Json
  createdAt DateTime @default(now())

  @@map("health_reports")
}
