# ==============================================================================
# CV STUDIO CLOUD - SERVER-SIDE CONFIGURATION (.env.example)
# ==============================================================================
# All database connections and API keys are strictly SERVER-SIDE only.
# Zero credentials, tokens or database URLs are ever exposed to the frontend.
# The client (React/Vite) only communicates with the Express backend via /api/*.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (SERVER-SIDE VIA PRISMA ORM)
# ------------------------------------------------------------------------------
# How to get your Supabase database credentials:
# 1. Go to your Supabase Dashboard -> Project Settings -> Database
# 2. In the "Connection string" section:
#    - Select "URI" and Mode "Transaction" (Port 6543 / Supavisor pooler) for DATABASE_URL
#    - Select "URI" and Mode "Session" / Direct (Port 5432) for DIRECT_URL (migrations)
#
# DATABASE_URL (Transaction Pooler - Port 6543):
# Used exclusively by the Express backend at runtime with Prisma Client.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL (Direct PostgreSQL connection - Port 5432):
# Used exclusively by the Prisma CLI for running schema migrations (npx prisma db push).
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 4. SUPABASE API CREDENTIALS (BACKEND)
# ------------------------------------------------------------------------------
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co/rest/v1/"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional: Local PostgreSQL fallback (if running PostgreSQL locally without Supabase):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cvstudiocloud?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cvstudiocloud?schema=public"

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION (JWT SIGNING SECRET)
# ------------------------------------------------------------------------------
# JWT_SECRET: Strong private secret used by Express backend to sign HttpOnly cookies.
# Never shared with the client. Change this to a random 64-character string in production.
JWT_SECRET="cv_studio_cloud_jwt_super_secret_key_2026_change_in_production"

# ------------------------------------------------------------------------------
# 3. APPLICATION RUNTIME & HOSTING
# ------------------------------------------------------------------------------
# APP_URL: Base public URL where the application is hosted (no trailing slash).
# Used for public CV sharing links, QR code generation, and recruiter previews.
APP_URL="http://localhost:3000"

# NODE_ENV: Server runtime environment ('development' | 'production')
NODE_ENV="development"
